# ===== App =====
NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:3000

# ===== Database (MySQL 8) =====
# Khớp docker-compose.yml (DB dev). Chạy `npm run db:up` để bật.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=devpass
DB_DATABASE=dau_accommodation
# Bật synchronize=false LUÔN — chỉ dùng migration (chuẩn dự án)
DB_SYNCHRONIZE=false
DB_LOGGING=true

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES=7d

# ===== OTP / SMS =====
# provider: mock | esms | twilio | zns  (MVP dùng mock - log ra console)
OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# ===== Tích hợp API tuyển sinh (DauAff) =====
INTEGRATION_API_BASE_URL=https://aff-api.ktd.edu.vn/api/v1/integration
# Lấy x-api-key từ phòng CNTT. Để trống → tân SV đăng nhập theo DB cục bộ (mock/đã sync).
INTEGRATION_API_KEY=

# ===== Storage (local) =====
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,video/mp4

# ===== Gửi email (Gmail SMTP qua App Password) =====
# Bật xác thực 2 bước rồi tạo App Password: https://myaccount.google.com/apppasswords
# Để trống → email chạy chế độ mock (chỉ log console, không gửi thật).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
# Email nhận thông báo khi có bài đăng mới chờ duyệt (mặc định = GMAIL_USER)
ADMIN_NOTIFY_EMAIL=

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================================================
# Biến môi trường PRODUCTION — copy thành .env.prod rồi điền giá trị thật.
# Dùng với: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# TUYỆT ĐỐI không commit .env.prod (đã nằm trong .gitignore).
# ============================================================================

# ----- Domain (đã trỏ DNS về máy chủ) -----
WEB_DOMAIN=dau-tro.vn
API_DOMAIN=api.dau-tro.vn

# ----- Web (Next.js) -----
# URL API công khai, NHÚNG LÚC BUILD. Phải khớp API_DOMAIN + /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://api.dau-tro.vn/api/v1

# ----- API <-> CORS -----
# Origin của web (để API cho phép gọi). Khớp WEB_DOMAIN, có https.
WEB_ORIGIN=https://dau-tro.vn

# ----- Database (MySQL trong compose) -----
DB_DATABASE=dau_accommodation
# Đặt mật khẩu mạnh — dùng cho cả MySQL root lẫn API.
DB_PASSWORD=doi-mat-khau-nay

# ----- JWT (BẮT BUỘC đổi sang chuỗi ngẫu nhiên dài) -----
# Gợi ý tạo: openssl rand -base64 48
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_REFRESH_SECRET=doi-thanh-chuoi-ngau-nhien-dai-khac

# ----- Tích hợp API tuyển sinh -----
INTEGRATION_API_BASE_URL=https://aff-api.ktd.edu.vn/api/v1/integration
INTEGRATION_API_KEY=

# ----- Email (Gmail SMTP App Password) -----
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# ----- Đăng nhập Google (chủ trọ) -----
# OAuth Client ID (Web application). Authorized origins phải gồm https://<WEB_DOMAIN>.
# Backend (GOOGLE_CLIENT_ID) và frontend (NEXT_PUBLIC_GOOGLE_CLIENT_ID) dùng cùng giá trị.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ----- Tài khoản admin tạo lần đầu (npm run seed:prod) -----
SEED_ADMIN_PHONE=0900000000
SEED_ADMIN_PASSWORD=doi-mat-khau-admin
